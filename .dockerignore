# Docker ignore patterns

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
buildspec.yml

# IDE
.vs
.vscode
.idea
*.swp
*.swo
*~

# Build artifacts
**/bin/
**/obj/
**/out/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# Test results
TestResults/
*.trx

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
!DOCKER.md

# Migrations (keep in Docker build)
# **/Migrations/

# Environment files
.env
.env.*
!.env.example

# User secrets
**/appsettings.Development.json
**/secrets.json

# Docker
docker-compose*.yml
!docker-compose.yml
Dockerfile
.dockerignore